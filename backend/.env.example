# Groq API (for extraction.py)
GROQ_API_KEY=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail: comma-separated list of every enquiry-receiving Gmail address
GMAIL_ACCOUNTS=default
# Which mail to pull each poll (Gmail search syntax) — default for every
# account that doesn't have its own override below
GMAIL_QUERY=is:unread
# Optional: per-account query overrides as a JSON object, for an inbox
# that's mixed personal + business mail rather than a dedicated business
# address. Scope it to a Gmail label you've filtered business mail into:
# GMAIL_QUERY_OVERRIDES={"rahul@personal-domain.com": "label:Business is:unread"}
GMAIL_QUERY_OVERRIDES=

# WhatsApp webhook verification (set this to any string you choose,
# then enter the same string in Meta's webhook setup screen)
WHATSAPP_VERIFY_TOKEN=change-me

# Daily digest (daily_digest.py) — summarizes overdue / due-soon / undated
# enquiries by email once a day.
# Must be one of the accounts already authorized in GMAIL_ACCOUNTS.
DIGEST_FROM_ACCOUNT=
# Comma-separated list of who should receive the digest
DIGEST_RECIPIENTS=
# Optional — included as a link at the top of the digest email
DASHBOARD_URL=
