# Claude API (for extraction.py)
ANTHROPIC_API_KEY=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail: which mail to pull each poll (Gmail search syntax)
GMAIL_QUERY=is:unread

# WhatsApp webhook verification (set this to any string you choose,
# then enter the same string in Meta's webhook setup screen)
WHATSAPP_VERIFY_TOKEN=change-me
